# 예시 값이다. 셸·PyCharm 환경변수로 설정한다. 이 파일은 자동으로 읽지 않는다.
# 비밀번호·API 키를 Git 또는 채팅에 올리지 않는다.
SQ_DB_BACKEND=mysql
SQ_ENVIRONMENT=PAPER_LOCAL
SQ_MYSQL_HOST=127.0.0.1
SQ_MYSQL_PORT=3306
SQ_MYSQL_DATABASE=sessionquant
SQ_MYSQL_USER=sessionquant
SQ_MYSQL_PASSWORD=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
SEC_USER_AGENT=SessionQuant YourName your-email@example.com
FRED_API_KEY=
# 아래 값은 이전 데이터 조회와 호환 실행 전용이다.
PQ_DB=data/pennyquant.db
PQ_REPORT=data/report.json
# Phase 0~4 새 실행 경로에서는 실제 주문을 활성화할 수 없다.
