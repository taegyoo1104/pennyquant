# setup-env로 실제 .env에 저장하면 CLI와 PyCharm 실행에서 자동으로 읽는다.
# 이 예시 파일 자체는 읽지 않는다. 기존 환경변수가 파일 값보다 우선한다.
# 비밀번호에 $나 #가 있으면 작은따옴표로 감싼다. setup-env는 자동 처리한다.
# 비밀번호·API 키를 Git 또는 채팅에 올리지 않는다.
SQ_DB_BACKEND=mysql
SQ_ENVIRONMENT=PAPER_LOCAL
SQ_MYSQL_HOST=127.0.0.1
SQ_MYSQL_PORT=3306
SQ_MYSQL_DATABASE=sessionquant
SQ_MYSQL_USER=sessionquant
SQ_MYSQL_PASSWORD=
# 뉴스 키는 setup-news로 한 번 저장할 수 있다.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
SEC_USER_AGENT=SessionQuant YourName your-email@example.com
FRED_API_KEY=
# 아래 값은 이전 데이터 조회와 호환 실행 전용이다.
PQ_DB=data/pennyquant.db
PQ_REPORT=data/report.json
# 실주문 활성화는 이 파일에 저장하지 않는다. 매 실행 명시적 CLI 확인이 필요하다.

# 07 원문 감사의 로컬 읽기는 별도 opt-in이다. 저장은 YAML 정책을 따른다.
SQ_LLM_AUDIT_ALLOW_READ=0
